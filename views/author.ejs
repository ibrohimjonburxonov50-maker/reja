<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portfolio Template</title>
    <link rel="stylesheet" href="/main.css">
</head>
<body>

    <!-- ASOSIY KONTEYNER -->
    <div class="main_frame">

        <!-- 1. CHAP SIDEBAR -->
        <div class="left_frame">
            <!-- Profil qismi -->
            <div class="left_1">
                <img src="images/profile.png" alt="Profile" class="profile-img">
                <h2>Steve</h2>
                <p class="profession">Software Engineer</p>
            </div>

            <!-- Social Ikonchalar -->
            <div class="left_icons">
                <a href="#" class="link_href"><div class="icon">🔗</div></a>
                <a href="#" class="link_href"><div class="icon">🔗</div></a>
                <a href="#" class="link_href"><div class="icon">🔗</div></a>
                <a href="#" class="link_href"><div class="icon">🔗</div></a>
                <a href="#" class="link_href"><div class="icon">🔗</div></a>
                <a href="#" class="link_href"><div class="icon">🔗</div></a>
            </div>

            <!-- Shaxsiy ma'lumotlar -->
            <div class="info-list">
                <div class="info-item"><span>Age:</span> <span>24</span></div>
                <div class="info-item"><span>Residence:</span> <span>BD</span></div>
                <div class="info-item"><span>Freelance:</span> <span class="available">Available</span></div>
                <div class="info-item"><span>Address:</span> <span>Dhaka, Bangladesh</span></div>
            </div>

            <hr class="divider">

            <!-- Tillar (Languages) -->
            <div class="skills-section">
                <h3>Languages</h3>
                <div class="skill-bar"><span>Bangla</span> <span>100%</span></div>
                <div class="progress"><div class="progress-line" style="width: 100%;"></div></div>
                
                <div class="skill-bar"><span>English</span> <span>80%</span></div>
                <div class="progress"><div class="progress-line" style="width: 80%;"></div></div>
                
                <div class="skill-bar"><span>Spanish</span> <span>60%</span></div>
                <div class="progress"><div class="progress-line" style="width: 60%;"></div></div>
            </div>

            <hr class="divider">

            <!-- Ko'nikmalar (Skills) -->
            <div class="skills-section">
                <h3>Skills</h3>
                <div class="skill-bar"><span>Html</span> <span>90%</span></div>
                <div class="progress"><div class="progress-line" style="width: 90%;"></div></div>

                <div class="skill-bar"><span>CSS</span> <span>85%</span></div>
                <div class="progress"><div class="progress-line" style="width: 85%;"></div></div>

                <div class="skill-bar"><span>Js</span> <span>80%</span></div>
                <div class="progress"><div class="progress-line" style="width: 80%;"></div></div>

                <div class="skill-bar"><span>PHP</span> <span>75%</span></div>
                <div class="progress"><div class="progress-line" style="width: 75%;"></div></div>

                <div class="skill-bar"><span>WordPress</span> <span>85%</span></div>
                <div class="progress"><div class="progress-line" style="width: 85%;"></div></div>
            </div>

            <hr class="divider">

            <!-- Qo'shimcha ko'nikmalar -->
            <div class="extra-skills">
                <h3>Extra Skills</h3>
                <ul>
                    <li>Bootstrap, Materialize</li>
                    <li>Stylus, Sass, Less</li>
                    <li>Gulp, Webpack, Grunt</li>
                    <li>GIT Knowledge</li>
                </ul>
            </div>
        </div>

        <!-- 2. O'NG ASOSIY KONTENT -->
        <div class="right_content">
            
            <!-- Banner qismi -->
            <div class="hero-banner">
                <!-- Orqa fon shakllari -->
                <div class="shape circle-1"></div>
                <div class="shape square-1"></div>
                <div class="shape triangle-1"></div>
                <div class="shape circle-2"></div>

                <div class="hero-text">
                    <h1>Doctor neurologists in OHSU Hospital</h1>
                    <p>Lorem Ipsum Dolor Sit Amet, Consectetur Adipiscing Elit. Et, Volutpat Feugiat Placerat Lobortis. Natoque Rutrum Semper Sed Suspendisse Nunc Lectus.</p>
                    <a href="#" class="hire-btn">HIRE ME &rarr;</a>
                </div>
                <div class="hero-img">
                    <img src="images/profile2.png" alt="Doctor">
                </div>
            </div>

            <!-- My Services qismi -->
            <div class="services-section">
                <h2>My Services</h2>
                <p class="services-desc">Amet Minim Mollit Non Deserunt Ullamco Est Sit Aliqua Dolor Do Amet Sint. Velit Officia Consequat Duis Enim Velit Mollit. Lorem Ipsum</p>
                
                <div class="services-grid">
                    <div class="service-card">
                        <div class="service-icon">💻</div>
                        <h3>Web Development</h3>
                        <p>Blog, E-Commerce</p>
                    </div>
                    <div class="service-card">
                        <div class="service-icon">🎨</div>
                        <h3>UI/UX Design</h3>
                        <p>Mobile App, Website Design</p>
                    </div>
                    <div class="service-card">
                        <div class="service-icon">🎙️</div>
                        <h3>Sound Design</h3>
                        <p>Voice Over, Beat Making</p>
                    </div>
                    <div class="service-card">
                        <div class="service-icon">🎮</div>
                        <h3>Game Design</h3>
                        <p>Character Design, Props & Objects</p>
                    </div>
                    <div class="service-card">
                        <div class="service-icon">📷</div>
                        <h3>Photography</h3>
                        <p>Portrait, Product Photography</p>
                    </div>
                    <div class="service-card">
                        <h3>Advertising</h3>
                        <p>Lorem Ipsum Dolor Sit Amet, Consectetur Adipiscing Elit.</p>
                        <a href="#" class="order-link">ORDER NOW &gt;</a>
                    </div>
                </div>
            </div>

        </div>

        <!-- 3. ENG O'NGDAGI MENYU PANEL (Doim o'z o'rnida turadi) -->
        <div class="right_nav_sidebar">
            <div class="theme-toggle">🌙</div>
            <div class="nav_icons_list">
                <a href="#" class="nav_icon_item active">🏠</a>
                <a href="#" class="nav_icon_item">💻</a>
                <a href="#" class="nav_icon_item">🎓</a>
                <a href="#" class="nav_icon_item">💼</a>
                <a href="#" class="nav_icon_item">✉️</a>
            </div>
        </div>

    </div>

</body>
</html>